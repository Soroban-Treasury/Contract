# Used by scripts/deploy.sh. Copy to .env (never commit it).

# Name of a stellar-cli identity that pays for the deployment:
#   stellar keys generate treasury-deployer --network testnet --fund
SOURCE=treasury-deployer

# Owners (G... addresses, comma-separated) and how many must approve a payment.
OWNERS=
THRESHOLD=2

# Starting spending limit, in the token's smallest unit (1 XLM = 10000000), per period in seconds.
LIMIT_AMOUNT=
LIMIT_PERIOD_SECS=86400
# Token contract id. Leave empty for the network's XLM.
LIMIT_ASSET=

# Mainnet only: link to the audit report, or ACKNOWLEDGE_UNAUDITED=yes.
# AUDIT_REPORT_URL=
# RPC_URL=
